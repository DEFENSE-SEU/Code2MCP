# Code2MCP environment variables
#
# Quick setup:
#   Windows PowerShell: Copy-Item .\env.example .\.env
#   Bash/macOS/Linux:   cp env.example .env
#
# Default path:
#   Fill OPENAI_API_KEY before running Code2MCP.
#
# Codex-auth path:
#   If you already have a local Codex/OpenAI auth cache, you may leave
#   OPENAI_API_KEY empty and set MODEL_PROVIDER=openai-codex.

# ==================== LLM Configuration ====================
# Options: openai | openai-codex | deepseek | qwen | claude | bedrock | ollama
MODEL_PROVIDER=openai

# Required for the default OpenAI path.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5
# Model used only in generated OpenAI Responses API copy examples.
# Defaults to OPENAI_MODEL when empty, then to gpt-5. It intentionally does
# not use OPENAI_CODEX_MODEL because Codex auth/cache models are a separate path.
OPENAI_RESPONSES_MODEL=

# Optional OpenAI Codex subscription path.
# If OPENAI_CODEX_AUTH_FILE is empty, Code2MCP tries ~/.codex/auth.json.
OPENAI_CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
OPENAI_CODEX_MODEL=gpt-5.5
OPENAI_CODEX_AUTH_FILE=

# DeepSeek Configuration
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Qwen Configuration
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-3

# Claude Configuration
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-4-sonnet

# AWS Bedrock Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-4-sonnet

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# Common model parameters
MODEL_TEMPERATURE=0.1
MODEL_MAX_TOKENS=16384
MODEL_TIMEOUT=300
MODEL_MAX_RETRIES=10

# ==================== Optional Analysis Services ====================
# Optional Jina Reader API key for more precise repository analysis.
JINA_API_KEY=

# ==================== Hugging Face Configuration ====================
# Fill these only if you plan to publish deployment artifacts to Spaces.
HF_TOKEN=
HF_USERNAME=
AUTO_DEPLOY_HF=false
HF_PUSH=false

# ==================== Auto-Connect Configuration ====================
# Options: cursor | claude | empty
AUTO_CONNECT_CLIENT=

# ==================== Agent Configuration ====================
AGENT_USE_LLM=true
AGENT_MAX_ITERATIONS=5
AGENT_AUTO_FIX=true
AGENT_TEST_TIMEOUT=60

# ==================== Workflow Configuration ====================
WORKFLOW_OUTPUT_DIR=./output
WORKFLOW_MAX_RETRIES=3
WORKFLOW_ENABLE_LOGGING=true
WORKFLOW_LOG_LEVEL=INFO
CODE2MCP_MAX_DIRECT_FIX_ATTEMPTS_PER_RUN=1
# Set true only when you want to use conda after uv/venv fail.
CODE2MCP_ENABLE_CONDA=false
# Optional Python executable for venv creation. Set this when the default
# `python` on PATH is older than 3.10.
CODE2MCP_PYTHON=
CODE2MCP_BASE_INSTALL_TIMEOUT=600
CODE2MCP_DEP_INSTALL_TIMEOUT=300
CODE2MCP_TEST_TIMEOUT=300
CODE2MCP_CLIENT_VALIDATION_TIMEOUT=240
# Require at least one called tool to return {"success": true}. Keep true for
# production validation; set false only for transport-only diagnostics.
CODE2MCP_CLIENT_VALIDATION_REQUIRE_SEMANTIC_SUCCESS=true
# Require at least one successful called tool to return a non-empty result.
# Keep true for production validation; set false only for diagnostics.
CODE2MCP_CLIENT_VALIDATION_REQUIRE_MEANINGFUL_RESULT=true
# Client validation semantic policy:
# - all: default, fail if any called tool returns success=false
# - any: require at least one called tool to return success=true
# - none: validate transport/call success only
CODE2MCP_CLIENT_VALIDATION_SEMANTIC_POLICY=all
# Keep false by default. Class wrappers often expose object construction rather
# than a stable task tool; enable only for projects with safe zero-arg classes.
CODE2MCP_ENABLE_CLASS_WRAPPERS=false
# Keep false to avoid slow optional scientific/native packages during smoke
# validation. Set true for deeper project-specific dependency installation.
CODE2MCP_INSTALL_HEAVY_IMPORT_DEPS=false
# Keep false so env setup prefers package metadata and AST-discovered import
# packages before full requirements.txt files, which often contain docs/dev
# dependencies. Set true when you want requirements.txt installed first.
CODE2MCP_INSTALL_FULL_REQUIREMENTS_FIRST=false
# Keep these false for faster deterministic generation. Set true only when
# you explicitly want LLM-written adapter/readme artifacts.
CODE2MCP_ADAPTER_LLM=false
CODE2MCP_README_LLM=false
# Keep false for auditable RRF by default. Set true only when you explicitly
# want LLM-written runtime failure analysis and direct generated-file repairs.
CODE2MCP_REVIEW_LLM=false
# Keep false for production validation. Set true only when you want
# optional LLM-written finalize summaries/reports after validation.
CODE2MCP_FINALIZE_LLM=false
# Keep false for validation runs. Set true only when you explicitly want
# finalize to start the generated local Docker service.
CODE2MCP_LOCAL_AUTORUN=false

# ==================== DeepWiki MCP Configuration ====================
# External DeepWiki/Jina analysis is opt-in. Leave disabled for deterministic
# local and benchmark runs; AST/local source analysis remains the source of truth.
CODE2MCP_ANALYSIS_USE_DEEPWIKI=false
# Emergency override: set true to skip DeepWiki and Jina even when explicitly enabled.
DISABLE_DEEPWIKI=false
DEEPWIKI_MCP_URL=https://mcp.deepwiki.com/sse
DEEPWIKI_MCP_TIMEOUT=30
DEEPWIKI_MCP_ENABLE_MOCK=true

# ==================== Analysis Configuration ====================
ANALYSIS_MAX_TOKENS=8000
ANALYSIS_MAX_FILE_TOKENS=2000
ANALYSIS_MIN_CHARS=500
CODE2MCP_ANALYSIS_LLM=false
ANALYSIS_LOCAL_SCAN_MAX_CONTENT_FILES=50
ANALYSIS_LOCAL_SCAN_MAX_FILE_CHARS=1000
